{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "xf86conf",
  "rules": {
    "file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "section"
      }
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "#"
        },
        {
          "type": "PATTERN",
          "value": "[ \\t\\v]*"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "PATTERN",
            "value": "[^\\n]*"
          },
          "named": true,
          "value": "body"
        }
      ]
    },
    "section": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "Section"
        },
        {
          "type": "SYMBOL",
          "name": "section_name"
        },
        {
          "type": "SYMBOL",
          "name": "body"
        },
        {
          "type": "STRING",
          "value": "EndSection"
        }
      ]
    },
    "body": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "subsection"
          },
          {
            "type": "SYMBOL",
            "name": "directive"
          }
        ]
      }
    },
    "subsection": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "SubSection"
        },
        {
          "type": "SYMBOL",
          "name": "section_name"
        },
        {
          "type": "SYMBOL",
          "name": "body"
        },
        {
          "type": "STRING",
          "value": "EndSubSection"
        }
      ]
    },
    "section_name": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "SYMBOL",
          "name": "name"
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "name": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "InputDevice"
        },
        {
          "type": "STRING",
          "value": "InputClass"
        },
        {
          "type": "STRING",
          "value": "Monitor"
        },
        {
          "type": "STRING",
          "value": "Modes"
        },
        {
          "type": "STRING",
          "value": "Screen"
        },
        {
          "type": "STRING",
          "value": "Device"
        },
        {
          "type": "STRING",
          "value": "ServerLayout"
        },
        {
          "type": "STRING",
          "value": "Module"
        },
        {
          "type": "STRING",
          "value": "Extensions"
        },
        {
          "type": "STRING",
          "value": "Files"
        },
        {
          "type": "STRING",
          "value": "ServerFlags"
        },
        {
          "type": "STRING",
          "value": "DRI"
        },
        {
          "type": "STRING",
          "value": "Vendor"
        },
        {
          "type": "STRING",
          "value": "Pointer"
        },
        {
          "type": "STRING",
          "value": "Keyboard"
        }
      ]
    },
    "directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "SYMBOL",
          "name": "_value"
        }
      ]
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "string"
          }
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SYMBOL",
            "name": "int"
          }
        },
        {
          "type": "SYMBOL",
          "name": "float"
        },
        {
          "type": "SYMBOL",
          "name": "range"
        }
      ]
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "PATTERN",
              "value": "[^\"\\\\]"
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "_int": {
      "type": "PATTERN",
      "value": "\\d+"
    },
    "int": {
      "type": "SYMBOL",
      "name": "_int"
    },
    "float": {
      "type": "PREC",
      "value": 2,
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "_int"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "STRING",
                "value": "."
              },
              {
                "type": "SYMBOL",
                "name": "_int"
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "_int"
              },
              {
                "type": "STRING",
                "value": "."
              }
            ]
          }
        ]
      }
    },
    "range": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "int"
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": "-"
              }
            },
            {
              "type": "SYMBOL",
              "name": "int"
            }
          ]
        },
        {
          "type": "SEQ",
          "members": [
            {
              "type": "SYMBOL",
              "name": "float"
            },
            {
              "type": "IMMEDIATE_TOKEN",
              "content": {
                "type": "STRING",
                "value": "-"
              }
            },
            {
              "type": "SYMBOL",
              "name": "float"
            }
          ]
        }
      ]
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}